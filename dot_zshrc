#
# .zshrc is sourced in interactive shells.
# It should contain commands to set up aliases,
# functions, options, key bindings, etc.
#

autoload -U compinit
compinit

#allow tab completion in the middle of a word
setopt COMPLETE_IN_WORD

## keep background processes at full speed
setopt NOBGNICE
## restart running processes on exit
#setopt HUP

# The location of the history file
HISTFILE="$HOME/.zsh_history"

# How many lines to keep in the internal memory
HISTSIZE=10000

# How many lines to save in the file on disk
SAVEHIST=10000

# Options
setopt APPEND_HISTORY          # Append to the file, don't overwrite
setopt INC_APPEND_HISTORY      # Write to the file immediately after each command
setopt SHARE_HISTORY           # Share history between different sessions
setopt HIST_IGNORE_DUPS        # Don't record an entry if it's a duplicate of the previous one

## never ever beep ever
setopt NO_BEEP

## automatically decide when to page a list of completions
#LISTMAX=0

## disable mail checking
#MAILCHECK=0

export ZSH="$HOME/.oh-my-zsh"

# Install zsh-autosuggestions if missing
ZSH_AUTOSUGGEST_DIR="$ZSH/custom/plugins/zsh-autosuggestions"

# Check if the plugin directory exists; if not, clone it
if [[ ! -d "$ZSH_AUTOSUGGEST_DIR" ]]; then
    echo "Installing zsh-autosuggestions..."
    git clone https://github.com/zsh-users/zsh-autosuggestions "$ZSH_AUTOSUGGEST_DIR"
fi

# Check if zsh syntax highlighting is present
if [[ -f "/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    source "/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
else
    echo "Warning: zsh-syntax-highlighting not found at /usr/share/..."
    echo "Install via sudo apt install zsh-syntax-highlighting"
fi

# Function to ensure oh-my-posh is present
if ! command -v oh-my-posh &> /dev/null; then
    echo "oh-my-posh not found. Installing..."
    # Use -s to pass arguments if needed, though the official script is usually standalone
    curl -s https://ohmyposh.dev/install.sh | bash -s
    export PATH=$PATH:/usr/local/bin 
fi

source "$ZSH_AUTOSUGGEST_DIR/zsh-autosuggestions.zsh"

# Initialize if the command is now available
if command -v oh-my-posh &> /dev/null; then
    eval "$(oh-my-posh init zsh --config https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/jandedobbeleer.omp.json)"
fi
